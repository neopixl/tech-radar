@@ -0,0 +1,22 @@
+// Neopixl patch: support more than 4 quadrants.
+//
+// Angles are in degrees, clockwise from 12 o'clock. Each entry is the start
+// angle of the quadrant at that position (1-based), and each quadrant spans
+// 360 / count degrees. The 4-quadrant layout is AOE's original one.
+const startAnglesByCount: Record<number, number[]> = {
+  // top-left, top-right, bottom-left, bottom-right
+  4: [270, 0, 180, 90],
+  // top-left, top-right, bottom-left, bottom-right, bottom
+  5: [288, 0, 216, 72, 144],
+};
+
+export function getQuadrantSweep(count: number): number {
+  return 360 / count;
+}
+
+export function getQuadrantStartAngle(position: number, count: number): number {
+  const angles = startAnglesByCount[count];
+  if (angles) return angles[position - 1];
+  // Generic fallback: consecutive slices starting at 12 o'clock.
+  return (position - 1) * getQuadrantSweep(count);
+}
